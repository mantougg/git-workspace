{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitWorkspace",
  "version": "0.4.2",
  "identifier": "com.gitworkspace.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitWorkspace",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2NEY2REM0OThCNjgxOUUKUldTZWdiYVl4RzFQTnZKWEFkbzRPTU1DbEhNMTMvTTdMNFZlOGt0SXE3endIc3NENlVPank5TWoK",
      "endpoints": [
        "https://github.com/mantougg/git-workspace/releases/latest/download/latest.json"
      ]
    }
  }
}
